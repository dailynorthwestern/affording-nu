---
import { asset, safeURL } from '../lib/content.js';
const { story } = Astro.props;
const { hero } = story;
---
<section class="hero" aria-labelledby="story-title">
  <div class="hero-content">
    <img class="hero-publication" src={asset('/images/dailynu-hero-light.svg')} alt="The Daily Northwestern" width="525" height="47" />
    <h1 id="story-title">{story.title}</h1>
    {hero.showDek && <p class="hero-dek">{story.dek}</p>}
    <p class="hero-byline">
      {story.authors.map((author, i) => <>{i > 0 && (i === story.authors.length - 1 ? ' and ' : ', ')}{author.url ? <a href={safeURL(author.url)}>{author.name}</a> : <span>{author.name}</span>}{author.role && <span>, {author.role}</span>}</>)}
    </p>
    <p class="hero-date"><span class="hero-photo-credit"><a href="https://dailynorthwestern.com/staff_name/quinn-yates/">Photos by Quinn Yates</a></span><span class="meta-dot"> · </span><time datetime={story.date}>{new Date(`${story.date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time></p>
    {story.contentWarning && <p class="hero-warning">Content warning: {story.contentWarning}</p>}
  </div>
  <div class="hero-visual" aria-hidden="true">
    <video class="hero-media" autoplay loop muted playsinline preload="auto" data-hero-video tabindex="-1"><source src={asset(hero.video)} type="video/mp4" /></video>
  </div>
  <a href="#intro-steps" class="scroll-cue" aria-label="Scroll to article"><span aria-hidden="true">↓</span></a>
</section>
<script>
  const hero = document.querySelector('.hero');
  const heroVideo = hero?.querySelector('[data-hero-video]');
  const setHeroRatio = () => {
    if (heroVideo?.videoWidth && heroVideo?.videoHeight) {
      hero.style.setProperty('--hero-ratio', `${heroVideo.videoWidth} / ${heroVideo.videoHeight}`);
    }
  };
  heroVideo?.addEventListener('loadedmetadata', setHeroRatio);
  setHeroRatio();
</script>
