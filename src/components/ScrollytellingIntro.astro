---
import { asset, inline } from '../lib/content.js';
const { story, block } = Astro.props;
const scrollMedia = block?.scrollMedia || story.intro.scrollMedia;
const paragraphs = block?.paragraphs || story.introParagraphs;
const label = block?.label || 'Story opening';
---
<section class:list={['story-intro', { 'story-intro-fencing': block?.label === 'Fencing club' }]} data-story-intro aria-label={label}>
  <div class="intro-stage">
    <div class="intro-background" aria-hidden="true">
      {scrollMedia.type === 'video' ? (
        <video src={asset(scrollMedia.src)} poster={scrollMedia.poster ? asset(scrollMedia.poster) : undefined} muted loop playsinline preload="metadata" data-intro-video tabindex="-1" />
      ) : <img src={asset(scrollMedia.src)} alt="" />}
      {paragraphs.map((paragraph, index) => paragraph.media && <img class="intro-background-alternate" data-media-panel={index} src={asset(paragraph.media.src)} alt="" />)}
    </div>
    {scrollMedia.type === 'video' && <button class="intro-sound-toggle" type="button" data-intro-sound aria-label="Turn sound on" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M11 5 6 9H3v6h3l5 4V5Z"/><path class="sound-waves" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="sound-muted" d="m16 9 5 6m0-6-5 6"/></svg>
    </button>}
    <div class="intro-panels">
      {paragraphs.map((paragraph, index) => <p class="intro-panel" data-intro-panel={index} set:html={inline(paragraph.text)} />)}
    </div>
  </div>
  <div class="intro-track" aria-hidden="true">
    <div id="intro-steps">
      {paragraphs.map((_, index) => <div class="intro-step" data-intro-step={index}></div>)}
    </div>
  </div>
</section>
<script>
  import '../scripts/intro.js';
</script>
<style>
.story-intro { position: relative; margin-block: 3rem; background: #17151a; color: white; }
.story-intro-fencing.intro-enhanced .intro-background > img { opacity: 0; transition: opacity 1.2s ease; }
.story-intro-fencing.intro-enhanced.is-visible .intro-background > img { opacity: 1; }
.intro-stage { position: relative; }
.intro-background { position: absolute; inset: 0; }
.intro-background video, .intro-background img { width: 100%; height: 100%; object-fit: cover; }
.intro-background .intro-background-alternate { position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease; }
.intro-background .intro-background-alternate.is-active { opacity: 1; }
.intro-sound-toggle { position: absolute; z-index: 2; right: 1rem; bottom: 1rem; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: .6rem; border: 1px solid rgb(255 255 255 / .8); border-radius: 50%; background: rgb(0 0 0 / .55); color: white; cursor: pointer; }
.intro-sound-toggle svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.intro-sound-toggle .sound-muted { display: none; }
.intro-sound-toggle[aria-pressed="true"] .sound-waves { display: none; }
.intro-sound-toggle[aria-pressed="true"] .sound-muted { display: block; }
.intro-background::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 25%, rgb(0 0 0 / .8)); }
.intro-panels { position: relative; padding: 32px 20px; }
.intro-panel { max-width: 680px; margin: 0 auto 2em; font: 400 20px/1.4 var(--font-editorial); text-shadow: 0 2px 4px rgb(0 0 0 / .9), 0 4px 16px rgb(0 0 0 / .7); }
.intro-track { display: none; }
.intro-enhanced .intro-stage { position: sticky; top: var(--header-height); height: calc(100svh - var(--header-height)); overflow: hidden; }
.intro-enhanced .intro-panels { position: absolute; inset: 0; display: grid; align-items: end; padding: 32px 20px max(9svh, env(safe-area-inset-bottom)); pointer-events: none; }
.intro-enhanced .intro-panel { grid-area: 1/1; width: 100%; margin: 0 auto; opacity: 0; transform: translateY(18px); transition: opacity .4s ease, transform .4s ease; }
.intro-enhanced .intro-panel.is-active { opacity: 1; transform: translateY(0); }
.intro-enhanced .intro-track { display: block; position: relative; margin-top: calc(-100svh + var(--header-height)); pointer-events: none; }
.intro-step { height: calc(100svh - var(--header-height)); }
@media (max-width: 600px) {
  .intro-enhanced .intro-panels { padding: 24px 20px max(6svh, env(safe-area-inset-bottom)); }
}
@media (max-width: 700px) {
  .intro-panel { font-size: 18px; }
}
@media (max-height: 500px) {
  .intro-enhanced .intro-panels { padding-bottom: 20px; }
}
@media (prefers-reduced-motion: reduce) {
  .intro-enhanced .intro-panel { transform: none; transition: none; }
  .story-intro-fencing.intro-enhanced .intro-background > img { transition: none; opacity: 1; }
}
</style>
